# Copy this file to ".env" in the project root and fill in real values.
# docker-compose reads this file automatically.

# ---------- Cloudinary (image storage) ----------
# Get these from https://console.cloudinary.com/ (Dashboard tab)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- JWT ----------
# Any long random string (32+ characters). Generate one with:
#   openssl rand -base64 48
JWT_SECRET_KEY=change_this_to_a_long_random_secret_value

# ---------- AWS ----------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
